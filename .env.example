# ─── Client (build-time, baked into the Vite bundle) ───────────────────────────
# Set this to your production API URL (e.g., https://api.yourdomain.com)
VITE_API_URL=https://mauliksharma.org

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Use the local Docker mongo container by default.
# For production with Atlas, set your full connection string here.
MONGO_URI=mongodb://mongo:27017/portfolio
MONGO_PORT=27017

# ─── Express ───────────────────────────────────────────────────────────────────
SERVER_PORT=5000

# ─── Client ────────────────────────────────────────────────────────────────────
CLIENT_PORT=3000
CLIENT_ORIGIN=https://mauliksharma.org

# ─── Nodemailer ────────────────────────────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=
NOTIFY_EMAIL=
